  "description": "MCP server for job search across LinkedIn, Computrabajo, Greenhouse, Lever, Ashby, RemoteOK and Remotive. No login, no API keys, no dependencies.",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "linkedin-jobs-mcp": "server.mjs"
  },
